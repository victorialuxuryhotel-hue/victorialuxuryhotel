{
  "name": "victoria-hotel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "tests/e2e/run.sh",
    "check": "node scripts/check-migrations.mjs && pnpm typecheck && pnpm lint && pnpm test",
    "db:migrate": "wrangler d1 migrations apply victoria-hotel-db --local --persist-to \"$HOME/.cache/victoria-hotel/wrangler\"",
    "db:seed": "wrangler d1 execute victoria-hotel-db --local --persist-to \"$HOME/.cache/victoria-hotel/wrangler\" --file db/seed.sql",
    "db:demo": "wrangler d1 execute victoria-hotel-db --local --persist-to \"$HOME/.cache/victoria-hotel/wrangler\" --file db/demo.sql",
    "db:fresh": "rm -rf \"$HOME/.cache/victoria-hotel/wrangler/v3/d1\" && pnpm db:migrate && pnpm db:seed && pnpm db:demo",
    "db:migrate:remote": "wrangler d1 migrations apply victoria-hotel-db --remote",
    "staff:create-owner": "node scripts/create-owner.mts",
    "mock:integrations": "node tests/mocks/integrations-mock.mjs",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-env=false cloudflare-env.d.ts",
    "cf:build": "opennextjs-cloudflare build && node scripts/strip-build-secrets.mjs",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "pnpm cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@clerk/nextjs": "7.10.8",
    "@opennextjs/cloudflare": "1.20.18",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "4.1.4",
    "wrangler": "4.167.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
