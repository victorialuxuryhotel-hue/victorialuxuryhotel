{
  "name": "victoria-hotel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "db:seed-staff": "scripts/seed-dev-staff.sh",
    "staff:create": "node scripts/create-staff.mts",
    "test:e2e": "tests/e2e/run.sh",
    "mock:integrations": "node tests/mocks/integrations-mock.mjs",
    "db:demo": "docker exec -i supabase_db_victoria-hotel psql -U postgres -v ON_ERROR_STOP=1 -q < supabase/demo.sql",
    "db:fresh": "pnpm db:reset && pnpm db:seed-staff && pnpm db:demo",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postgres": "4.1.1",
    "puppeteer-core": "^24.43.1",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "4.1.4",
    "wrangler": "4.165.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
