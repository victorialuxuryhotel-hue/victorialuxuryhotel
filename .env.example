# Copy to .env.local for local development. Never commit real values.
# Test and live credentials must live in separate Vercel environments.

# --- Public (exposed to the browser) ---------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# `supabase status` prints this as the "Publishable key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ---------------------------
# `supabase status` prints this as the "Secret key". Bypasses RLS: server code only.
SUPABASE_SECRET_KEY=

# Paystack: use sk_test_... until the hotel's live account is verified.
PAYSTACK_SECRET_KEY=

# Leave unset in production. Tests point these at a local mock.
# PAYSTACK_BASE_URL=http://127.0.0.1:4010
# RESEND_BASE_URL=http://127.0.0.1:4010

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM="Victoria Luxury Hotel <bookings@example.com>"
# Optional: the hotel's inbox gets a copy of each confirmed booking
HOTEL_NOTIFY_EMAIL=

# Shared secret for the scheduled job that expires unpaid reservations
CRON_SECRET=

# Optional: Slack/Discord incoming webhook for operational alerts
# (payments needing attention, failed emails, webhook or scheduled job errors)
ALERT_WEBHOOK_URL=

# Optional: per-visitor limits on the public site (defaults 6 holds, 20 payment starts per hour)
# RATE_LIMIT_HOLDS_PER_HOUR=6
# RATE_LIMIT_PAYMENTS_PER_HOUR=20
