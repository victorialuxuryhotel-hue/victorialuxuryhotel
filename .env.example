# Copy to .env.local for local development. Never commit real values.
# The database (D1) and photo storage (R2) are Cloudflare bindings, not env
# vars: locally they live in .wrangler/state (pnpm db:fresh).

# --- Public (exposed to the browser) ---------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk (staff sign-in). Leave both empty locally to use Clerk's keyless
# development mode (a temporary Clerk app you can later claim). Production:
# keys from a Clerk production instance on the hotel's domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ---------------------------
CLERK_SECRET_KEY=

# Paystack: use sk_test_... until the hotel's live account is verified.
PAYSTACK_SECRET_KEY=

# Leave unset in production. Tests point these at a local mock.
# PAYSTACK_BASE_URL=http://127.0.0.1:4010
# RESEND_BASE_URL=http://127.0.0.1:4010

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM="Victoria Luxury Hotel <bookings@example.com>"
# Optional: the hotel's inbox gets a copy of each confirmed booking
HOTEL_NOTIFY_EMAIL=

# Shared secret for the scheduled job that expires unpaid reservations
CRON_SECRET=

# Optional: Slack/Discord incoming webhook for operational alerts
# (payments needing attention, failed emails, webhook or scheduled job errors)
ALERT_WEBHOOK_URL=

# Random value used to hash visitor IPs for rate limiting
RATE_LIMIT_SALT=

# Optional: per-visitor limits on the public site (defaults 6 holds, 20 payment starts per hour)
# RATE_LIMIT_HOLDS_PER_HOUR=6
# RATE_LIMIT_PAYMENTS_PER_HOUR=20

# Owner, general manager, hotel manager and finance must sign in with an authenticator app.
# Set to 1 to skip that on your own machine (ignored unless NEXT_PUBLIC_SITE_URL is localhost).
# TWO_STEP_OPTIONAL=1

# Signs the owner's "View as front desk" cookie (32+ characters). Without it, view-as is off.
VIEW_AS_SECRET=
