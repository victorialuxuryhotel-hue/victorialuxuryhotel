{
  // Cloudflare Worker for the Victoria Luxury Hotel app (built with OpenNext).
  // Pages are served with a read-only cache from static assets (see
  // open-next.config.ts), so no R2 bucket or D1 database is needed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "victorialuxuryhotel",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference used by OpenNext for cache revalidation.
    { "binding": "WORKER_SELF_REFERENCE", "service": "victorialuxuryhotel" }
  ],
  // The hotel database. Schema and business rules: migrations/*.sql
  // (apply with `pnpm db:migrate`, or `--remote` for production).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "victoria-hotel-db",
      "database_id": "f14f8279-a2df-4fe8-99fd-0522934463e5",
      "migrations_dir": "migrations"
    }
  ],
  // Hotel photos (room types and website), served by /media/[...key].
  // R2 must be enabled on the account before the first deploy.
  // The hotel's domain (DNS on Cloudflare). workers.dev stays on as a fallback address.
  "routes": [
    { "pattern": "victorialuxuryhotel.com", "custom_domain": true },
    { "pattern": "www.victorialuxuryhotel.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "victorialuxuryhotel" }],
  // next/image optimization via Cloudflare Images.
  "images": { "binding": "IMAGES" },
  // Housekeeping every 10 minutes: settle pending payments, expire unpaid
  // holds, send/retry queued emails (see worker.ts).
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true },
  // Local preview (pnpm cf:preview) serves on the same port as `next dev`, so
  // the site URL baked into the build (NEXT_PUBLIC_SITE_URL) matches.
  "dev": { "port": 3000 },

  // Staging: same code, its own worker, database and photo bucket, on staging.victorialuxuryhotel.com.
  // Uses Clerk's development instance and Paystack test mode. Every merge to main deploys here first
  // (.github/workflows/deploy.yml). Bindings aren't inherited by environments, so each is repeated.
  "env": {
    "staging": {
      "name": "victorialuxuryhotel-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "victorialuxuryhotel-staging" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "victoria-hotel-db-staging",
          "database_id": "f50fe2e3-cf53-4b9b-a098-ec5b3ade0d79",
          "migrations_dir": "migrations"
        }
      ],
      "routes": [{ "pattern": "staging.victorialuxuryhotel.com", "custom_domain": true }],
      "workers_dev": true,
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "victorialuxuryhotel-staging" }],
      "images": { "binding": "IMAGES" },
      "triggers": { "crons": ["*/10 * * * *"] },
      "observability": { "enabled": true }
    }
  }
}
